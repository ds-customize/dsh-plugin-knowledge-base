{
  "name": "dsh-plugin-knowledge-base",
  "description": "Local knowledge base for dsh web: composer-managed directory/file connections, per-question retrieval via the knowledge_base tool",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ds-customize/dsh-plugin-knowledge-base.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/ds-customize/dsh-plugin-knowledge-base/issues"
  },
  "homepage": "https://github.com/ds-customize/dsh-plugin-knowledge-base#readme"
}
